<EditForm Model="user" OnValidSubmit="ExecuteLogin" class="card card-body bg-light mt-5">
    <DataAnnotationsValidator />
    <div class="form-group row">
        <label for="email" class="col-md-2 col-form-label">Username:</label>
        <div class="col-md-10">
            <InputText id="email" class="form-control" @bind-Value="user.Username" />
            <ValidationMessage For="@(() => user.Username)" />
        </div>
    </div>
