@page "/products/add"
@attribute [Authorize]
@inject HttpClient Http
@using Microsoft.AspNetCore.Components.Forms

@inject IJSRuntime Js
@inject NavigationManager navManager
<h1> Add New Product </h1>

<MudGrid>
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4">
            <MudCardContent>
                <MudText Align="Align.Center">Product</MudText>
                <MudForm Model="@obj" @ref="@form">
                    <MudTextField @bind-Value="obj.ProductName"
                                  For="@(() => obj.ProductName)"
                                  Immediate="true"
                                  Label="Name" />

                    <MudTextField @bind-Value="obj.ProductType"
                                  For="@(() => obj.ProductType)"
                                  Immediate="true"
                                  Label="Type" />

                    <MudTextField @bind-Value="obj.ProductDescription"
                                  For="@(() => obj.ProductDescription)"
                                  Immediate="true"
                                  Label="Description" />
                    <MudNumericField @bind-Value="obj.ProductPrice" Label="Price" Variant="Variant.Filled" Min="0" />

                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles" Context="fileInput">
                        <ButtonTemplate>
                            <MudButton HtmlTag="label" for="@fileInput">Upload Image</MudButton>
                        </ButtonTemplate>
                    </MudFileUpload>

                    @if (browserFile != null)
                    {
                        <MudList T="string">
                            <MudListItem Icon="@Icons.Material.Filled.AttachFile" @key="@browserFile">
                                @browserFile.Name <code>@browserFile.Size bytes</code>
                            </MudListItem>
                        </MudList>
                    }
                </MudForm>
            </MudCardContent>

           <MudDivider DividerType="DividerType.Inset" />

            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="@(async () => await Submit(browserFile))">Add Product</MudButton>
            </MudCardActions>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="5">
        <MudPaper Class="pa-4">
            <MudCardContent>
                <MudForm Model="@pd" @ref="@form">
                    <MudText Align="Align.Center">Product Detail</MudText>
                    <MudTextField @bind-Value="pd.InventoryName"
                                  For="@(() => pd.InventoryName)"
                                  Immediate="true"
                                  Label="Name" />

                    <MudNumericField @bind-Value="pd.Qty" Label="Qty" Variant="Variant.Filled" Min="0" />

                    <MudTextField @bind-Value="pd.QtyDescription"
                                  For="@(() => pd.QtyDescription)"
                                  Immediate="true"
                                  Label="Description" />
                </MudForm>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="@SubmitDetail">Add Product Detail</MudButton>
            </MudCardActions>
        </MudPaper>
    </MudItem>
</MudGrid>

<h1>
    Product Detail
</h1>

@if (objPd == null)
{
    <h1>No Data</h1>

}
else
{
    <MudDataGrid T="ProductDetail" Items="@objPd">
        <Columns>
            <PropertyColumn Property="x => x.InventoryName" Title="Name" />
            <PropertyColumn Property="x => x.Qty" />
            <PropertyColumn Property="x => x.QtyDescription" />
        </Columns>
    </MudDataGrid>
}



