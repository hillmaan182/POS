@if (!string.IsNullOrEmpty(uploadMessage))
{
    <p>@uploadMessage</p>
}

@code {
    private IBrowserFile browserFile;
    private string uploadMessage;
    private string thumbnail;
    private Domain.Model.Product obj = new Domain.Model.Product();

    private ProductDetail pd = new ProductDetail();

    private List<ProductDetail> objPd = new List<ProductDetail>();

    MudForm form;

    void SubmitDetail()
    {
        ProductDetail newPd = new ProductDetail();
        newPd = pd;
        objPd.Add(newPd);

    }

    private async Task UploadFiles(IBrowserFile img)
    {
        browserFile = img;
        var buffers = new byte[browserFile.Size];
        await browserFile.OpenReadStream().ReadAsync(buffers);
        thumbnail = $"data:{browserFile.ContentType};base64,{Convert.ToBase64String(buffers)}";
        //TODO upload the files to the server
    }

    //private async Task InputFileChange(InputFileChangeEventArgs e)
    //{
    //    browserFile = e.File;
    //    var buffers = new byte[browserFile.Size];
    //    await browserFile.OpenReadStream().ReadAsync(buffers);
    //    thumbnail = $"data:{browserFile.ContentType};base64,{Convert.ToBase64String(buffers)}";
    //    uploadMessage = string.Empty; // Clear previous messages
    //}



    private async Task Submit(IBrowserFile browserFile)
    {
        await form.Validate();

        if (form.IsValid)
        {
            if (browserFile != null && browserFile.Size > 0)
            {
                try
                {
                    string imageType = browserFile.ContentType;
                    var buffers = new byte[browserFile.Size];
                    await browserFile.OpenReadStream().ReadAsync(buffers);
                    thumbnail = $"data:{browserFile.ContentType};base64,{Convert.ToBase64String(buffers)}";
                    string image = thumbnail;
                    Domain.Model.Product prod = new Domain.Model.Product();
                    prod = obj;
                    prod.ImageType = imageType;
                    prod.ProductImage = image;

                    string jsonString = JsonConvert.SerializeObject(prod);
                    var httpContent = new StringContent(jsonString, Encoding.UTF8, "application/json");

                    var response = await Http.PostAsync("api/Product", httpContent);


                    if (response.IsSuccessStatusCode)
                    {
                        uploadMessage = "File uploaded successfully!";
                        await Js.InvokeVoidAsync("Swal.fire", "Message", "Product has successfuly added", "success");
                        navManager.NavigateTo("/products");
                    }
                    else
                    {
                        uploadMessage = "Error uploading file: " + response.ReasonPhrase;
                    }
                }
                // Assuming you have an HttpClient instance injected or created

                catch (Exception ex)
                {
                    uploadMessage = "An error occurred: " + ex.Message;
                }
            }
            else
            {
                uploadMessage = "Please select a file to upload.";
            }
        }
    }

    public async Task<string> UploadProductImage(MultipartFormDataContent content)
    {
        var postResult = await Http.PostAsync("https://localhost:7085/api/ImageData/upload", content);
        var postContent = await postResult.Content.ReadAsStringAsync();
        if (!postResult.IsSuccessStatusCode)
        {
            throw new ApplicationException(postContent);
        }
        else
        {
            var imgUrl = Path.Combine("https://localhost:7085/", postContent);
            return imgUrl;
        }
    }

}