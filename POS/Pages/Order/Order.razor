<h3>Order</h3>

@*Page Section*@
@if (products == null)
{
    <p><em>There is no product...</em></p>
}
else
{
    <MudGrid>
        <MudItem xs="9">
            <MudTextField @bind-Value="CustomerName"
                      For="@(() => CustomerName)"
                      Immediate="true"
                      Label="Customer Name" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="3" Style="justify-content:center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ToggleDrawer())">Check Order</MudButton>
        </MudItem>
    </MudGrid>


    @*Product Section*@
    <MudGrid Spacing=3 Justify="Justify.FlexStart">
        @foreach (var item in products)
        {
            <MudItem xs="3">
                <MudCard Elevation="5">
                    <MudCardMedia Image="@item.ProductImage" Height="200" Width="100" />
                    <MudCardContent>
                        <MudText Typo="Typo.h5">@item.ProductName</MudText>
                        <MudText Typo="Typo.h6">@help.SetCurrency(item.ProductPrice.Value) </MudText>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ToggleDrawerAddOrder(item.Id))">Add</MudButton>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

<MudDrawer @bind-Open="@_openAddOrder" Overlay="false" Elevation="1" Variant="@DrawerVariant.Temporary" Anchor="Anchor.Start" Height="100vh" Width="120vh">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">Orders</MudText>
        <MudDivider />
    </MudDrawerHeader>
    <MudDrawerContainer>
        <MudGrid Spacing=3 Justify="Justify.Center">
            <MudItem xs="4">
                <MudCard>
                    <MudCardMedia Image="@perProduct.ProductImage" Height="200" Width="150" />
                    <MudCardContent>
                        <MudText Typo="Typo.h5">@perProduct.ProductName</MudText>
                        <MudText Typo="Typo.h6">@help.SetCurrency(perProduct.ProductPrice.Value) </MudText>
                        <MudNumericField Id="@perProduct.Id" @bind-Value="@qty"
                                         Label="Qty"
                                         Variant="Variant.Text"
                                         Min="1"/>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AddOrder(perProduct.Id))">Add Order</MudButton>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudDrawerContainer>
</MudDrawer>

@*Order Drawer Section*@
<MudDrawer @bind-Open="@_open" Overlay="false" Elevation="1" Variant="@DrawerVariant.Temporary" Anchor="Anchor.Start" Width="120vh" Height="100vh">
    <MudDrawerContainer>
        <MudText Typo="Typo.h6">Order Code : @orderCode</MudText>
        <MudDivider />
        <MudStack>
            @* @{
            foreach (var obj in tssDTO)
            {
            <MudPaper Square="true" Class="d-flex justify-space-around">
            <MudText Typo="Typo.h6" Align="Align.Center">
            @obj.Product.ProductName - @obj.Product.ProductPrice
            </MudText>
            <MudDivider Vertical="true" FlexItem="true" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => RemoveOrder(obj.OrderId))">-</MudButton>
            </MudPaper>
            }
            }*@
            <MudText>Customer : @CustomerName</MudText>
            <MudDataGrid Items="@tssDTO">
                <Columns>
                    <PropertyColumn Property="x => x.Product.ProductName" />
                    <PropertyColumn Property="x => x.Qty" />
                    <PropertyColumn Property="x => x.TotalQtyPrice" />
                    <TemplateColumn CellClass="d-flex justify-end">
                        <CellTemplate>
                            @{
                                var item = context.Item; // Access the current row's data
                            }
                            <MudStack Row>
                                <MudButton Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Primary" OnClick="@(() => RemoveOrder(item.OrderId))">-</MudButton>
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>


        </MudStack>
        <MudDivider />
    </MudDrawerContainer>
    <MudDrawerContainer>
        <MudText Typo="Typo.h6" Align="Align.Right">Total : @total</MudText>
    </MudDrawerContainer>
    <MudDrawerContainer>
        <MudItem Class="d-flex align-center justify-center mud-width-full">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SubmitOrder())">Order</MudButton>
        </MudItem>
    </MudDrawerContainer>
</MudDrawer>

<br>

@*Drawer QR Code*@
<MudDrawer @bind-Open="@_openQR" Width="100%" Height="450px" Anchor="Anchor.Top" Elevation="1" Variant="@DrawerVariant.Temporary">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">QR Code</MudText>
    </MudDrawerHeader>
    <MudDrawerContainer>
        <div class="d-flex justify-center">
            <MudImage ObjectFit="ObjectFit.Fill" ObjectPosition="ObjectPosition.Center" Height="400" Width="400" Src="@imageQR" Elevation="25" Class="rounded-lg" />
        </div>
    </MudDrawerContainer>
</MudDrawer>


