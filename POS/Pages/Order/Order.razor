    public async Task<string> setOrdeR()
    {
        HitpayPayload hload = new HitpayPayload();
        string jsonString = JsonConvert.SerializeObject(hload);
        var httpContent = new StringContent(jsonString, Encoding.UTF8, "application/json");

        HttpClient client = new HttpClient();
        client.BaseAddress = new Uri(urihitpay);
        var request = new HttpRequestMessage(HttpMethod.Post, urihitpay);
        request.Headers.Add("X-BUSINESS-API-KEY", apikey);
        var response = client.PostAsync(urihitpay, httpContent);
        return await response.Result.Content.ReadAsStringAsync();
    }
