@page "/products"
@inject HttpClient Http
<h3>Product List</h3>
@if (products == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <MudDataGrid Items="@products.Take(4)">
    <Columns>
        <PropertyColumn Property="x => x.Id" Title="Nr" />
        <PropertyColumn Property="x => x.ProductName" />
        <PropertyColumn Property="x => x.ProductType" />
    </Columns>
</MudDataGrid>
   @* <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.ProductName</td>
                    <td>@product.ProductType</td>
                </tr>
            }
        </tbody>
    </table>*@
}
@code {
    private List<Domain.Model.Product> products;
    protected override async Task OnInitializedAsync()
    {
        products = await Http.GetFromJsonAsync<List<Domain.Model.Product>>("api/Product");
    }
    
}