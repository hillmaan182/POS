@page "/products"
@inject HttpClient Http
@using Domain.Model
<h3>Product List</h3>
<MudButton Href="/products/add" Variant="Variant.Outlined">Add Product</MudButton>
@if (products == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <MudGrid Spacing="20" Justify="Justify.Center">
        @foreach (var item in products)
        {
            <MudItem xs="4">
                <MudCard>
                    <MudCardMedia Image="@item.ProductImage" Height="200" Width="100" />
                    <MudCardContent>
                        <MudText Typo="Typo.h5">@item.ProductName</MudText>
                        <MudText Typo="Typo.h6">Rp. @item.ProductPrice</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

        }
    </MudGrid>

}
@code {
    private List<Domain.Model.Product> products;
    protected override async Task OnInitializedAsync()
    {
        products = await Http.GetFromJsonAsync<List<Domain.Model.Product>>("api/Product");
    }

}