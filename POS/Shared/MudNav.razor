<MudNavMenu>
    <Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
        <Authorized>
            <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Store">Store</MudNavLink>
            <MudNavLink Match="NavLinkMatch.Prefix" Href="products" Icon="@Icons.Material.Filled.Coffee">Products</MudNavLink>
            <MudNavLink Match="NavLinkMatch.Prefix" Href="inventory" Icon="@Icons.Material.Filled.Inventory">Inventories</MudNavLink>
            <MudNavGroup Title="Order" Expanded="false" Icon="@Icons.Material.Filled.Calculate">
                <MudNavLink Match="NavLinkMatch.Prefix" Href="order" Icon="@Icons.Material.Filled.Calculate">Add Order</MudNavLink>
                <MudNavLink Match="NavLinkMatch.Prefix" Href="vieworder" Icon="@Icons.Material.Filled.GridView">View Order</MudNavLink>
            </MudNavGroup>
            <MudDivider/>
            <MudNavLink Match="NavLinkMatch.Prefix" Href="logout" Icon="@Icons.Material.Filled.Logout">Log out</MudNavLink>
        </Authorized>
    </Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
</MudNavMenu>

@code
{
    private bool _open = false;

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}