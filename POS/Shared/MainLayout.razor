@inherits LayoutComponentBase
@inject AppState AppState
@using Microsoft.AspNetCore.Components.Authorization;

@* Required *@
<MudThemeProvider />
@*<MudPopoverProvider />*@
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @*  <MudAppBar>
    My Application
    </MudAppBar>*@

    <MudPaper Height="100%" Style="overflow:auto; position:relative;">
        <MudDrawerContainer Class="mud-height-full">
            <MudDrawer @bind-Open="@_drawerOpen" Fixed="true" Elevation="1"
                       Variant="@DrawerVariant.Mini" OpenMiniOnHover="true" Breakpoint="Breakpoint.None" Style="padding-top:50px">
                <MudNav />
            </MudDrawer>

            <MudMainContent Style="padding-left:15px;height:100vh" >
                @Body
            </MudMainContent>

        </MudDrawerContainer>
    </MudPaper>

</MudLayout>
@code {
    private bool _isDarkMode = true;
    bool _drawerOpen = true;

    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; }
    
    protected override void OnInitialized()
    {
        AppState.openDrawer = true;
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

   
}

