{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DataContext": "Server=yourserver;Database=yourdb;Trusted_Connection=True;MultipleActiveResultSets=true;User ID=yourid;Password=yourpassword"
  },
  //Localhost
  "JWT": {
    "ValidAudience": "https://localhost:7169",
    "ValidIssuer": "https://localhost:7085",
    "Secret": "YourJWTTokenSecret",
    "TokenValidityInMinutes": 30,
    "RefreshTokenValidityInDays": 7
  },
  "EmailSettings": {
    "Username": "YourEmail",
    "Password": "YourPassword",
    "SmtpServer": "smtp.gmail.com",
    "Port": 587
  }
}